      "item": []
    },
    {
      "name": "Administración",
      "description": "E25–E31 (versiones, configuraciones, preguntas, claves, baremos y publicación). Casos de TEST-34.",
      "item": []
    },
    {
      "name": "Gestión",
      "description": "E18–E21 y E23 (sujetos y períodos). Casos de TEST-34.",
      "item": []
    }
  ]
}
