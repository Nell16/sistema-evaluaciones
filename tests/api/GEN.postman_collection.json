  },
  "item": [
    {
      "name": "GEN-01",
      "item": [
        {
          "name": "1 Catálogo vacío (antes de cargar datos)",
          "item": [
            {
              "name": "TC-GEN-01-001 E1 catálogo vacío",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/tests",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "tests"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 y lista vacía', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.eql([]);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "2 Catálogo y detalle (con GEN-01-datos-prueba.sql)",
          "item": [
            {
              "name": "TC-GEN-01-002 E1 lista solo los tests activos",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/tests",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "tests"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 y arreglo', () => {",
                      "  pm.response.to.have.status(200);",
                      "  pm.expect(pm.response.json()).to.be.an('array');",
                      "});",
                      "const lista = pm.response.json();",
                      "const t1 = lista.find((t) => t.codigo === 'TC01-T1');",
                      "const t2 = lista.find((t) => t.codigo === 'TC01-T2');",
                      "const t4 = lista.find((t) => t.codigo === 'TC01-T4');",
                      "pm.test('incluye T1, T2 y T4 con su número de subpruebas y solo los campos del contrato', () => {",
                      "  pm.expect(t1).to.include({ nombre: 'Test ficticio uno', numeroSubpruebas: 3 });",
                      "  pm.expect(t2).to.include({ numeroSubpruebas: 1 });",
                      "  pm.expect(t4).to.include({ numeroSubpruebas: 1 });",
                      "  lista.forEach((t) => pm.expect(Object.keys(t)).to.have.members(['id', 'codigo', 'nombre', 'numeroSubpruebas']));",
                      "});",
                      "pm.test('no incluye el test inactivo T3', () => {",
                      "  pm.expect(lista.map((t) => t.codigo)).to.not.include('TC01-T3');",
                      "});",
                      "if (t1 && t2 && t4) {",
                      "  pm.collectionVariables.set('t1Id', t1.id);",
                      "  pm.collectionVariables.set('t2Id', t2.id);",
                      "  pm.collectionVariables.set('t4Id', t4.id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "TC-GEN-01-003 E2 usa la edición publicada más reciente, sin preguntas ni claves",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v1/tests/{{t1Id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "tests",
                    "{{t1Id}}"
                  ]
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (!pm.variables.get('t1Id')) {",
                      "  throw new Error('Falta t1Id: ejecuta la carpeta completa en orden (ver docs/pruebas/GEN-01-casos-prueba-v1.md).');",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200 solo con los campos del contrato', () => {",
                      "  pm.response.to.have.status(200);",
                      "  const d = pm.response.json();",
                      "  pm.expect(Object.keys(d)).to.have.members(['id', 'codigo', 'nombre', 'versionFormularioId', 'subpruebas']);",
                      "  pm.expect(d.codigo).to.eql('TC01-T1');",
                      "  pm.expect(d.versionFormularioId).to.be.a('number');",
                      "  d.subpruebas.forEach((s) => pm.expect(Object.keys(s)).to.have.members(['codigo', 'nombre', 'orden', 'factor',",
                      "    'tiempoLimiteSegundos', 'tipoRespuesta', 'opciones', 'numeroPreguntas', 'maximoEntradas', 'tienePractica']));",
                      "});",
                      "pm.test('trae las 3 configuraciones de v2 y no la única de v1', () => {",
                      "  pm.expect(pm.response.json().subpruebas).to.have.lengthOf(3);",
                      "});"
                    ]
                  }
                }
              ]
            },
